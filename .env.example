# Copy to .env.local for local dev. In production these live in the Vercel
# env store. NEXT_PUBLIC_* values are inlined AT BUILD TIME — editing one in
# Vercel does nothing until the next deploy, and any stray whitespace in the
# stored value ships verbatim (a trailing newline in the GA id once broke
# analytics for every consenting visitor). Paste values with no quotes, no
# trailing spaces or newlines.

# Supabase (project abizphozurvgdjljwvfx)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical origin of the app (apex is the Webflow marketing site)
NEXT_PUBLIC_SITE_URL=https://app.mulliganclub.co

# Google Analytics 4 — must match /^G-[A-Z0-9]{6,}$/ or GA is disabled
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Web push (see src/app/api/push/route.ts for the server-side vars)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional: "true" enables the Apple sign-in button (deliberately off)
NEXT_PUBLIC_ENABLE_APPLE_SIGNIN=
